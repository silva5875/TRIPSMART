# Copie para .env e preencha com os valores do seu projeto Supabase
# (Project Settings > API no painel do Supabase).
#
# A publishable key é pública por natureza: ela vai no bundle do navegador e
# quem protege os dados é o RLS, não o segredo da chave. Nunca coloque a
# service_role key aqui -- ela ignora RLS e não pode ir para o front.

VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Domínio público do site, usado em canonical, Open Graph e JSON-LD.
# Opcional em desenvolvimento: sem ela, o app usa a origem atual.
# Em produção, defina com o domínio real, sem barra no final.
VITE_SITE_URL=""
